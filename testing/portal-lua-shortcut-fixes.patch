index 84175d4..7b1b9be 100755
--- a/mcp/hypr-agent-portal-mcp.py
+++ b/mcp/hypr-agent-portal-mcp.py
@@ -4100,6 +4100,13 @@ def key_from_args(args: dict[str, Any]) -> tuple[str, str]:
     if not isinstance(key, str) or not key:
         raise RuntimeError("key action requires key or keys")
     modifiers = args.get("modifiers") if isinstance(args.get("modifiers"), str) else ""
+    # The public `key` field documents shortcuts such as ctrl+t, too.
+    if "+" in key:
+        parts = key.split("+")
+        if any(not part for part in parts):
+            raise RuntimeError("empty component in key shortcut")
+        key = parts[-1]
+        modifiers = "+".join([*parts[:-1], *([modifiers] if modifiers else [])])
     return key, modifiers
 
 
