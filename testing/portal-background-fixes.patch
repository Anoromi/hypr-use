+    g_backgroundFrameTimer.reset();
+    g_backgroundFrameSurface.reset();
+}
+
+void wakeBackgroundSurface(const SP<CWLSurfaceResource>& surface) {
+    if (!surface || !g_pEventLoopManager) return;
+    g_backgroundFrameSurface = surface;
+    g_backgroundFrameDeadline = Time::steadyNow() + std::chrono::seconds(2);
+    const auto frame = [] {
+        if (const auto target = g_backgroundFrameSurface.lock()) {
+            target->breadthfirst([](SP<CWLSurfaceResource> child, const Vector2D&, void*) {
+                child->frame(Time::steadyNow());
+            }, nullptr);
+            wl_client_flush(target->client());
+        }
+    };
+    frame();
+    if (g_backgroundFrameTimer) return;
+    g_backgroundFrameTimer = makeShared<CEventLoopTimer>(std::chrono::milliseconds(16),
+        [frame](SP<CEventLoopTimer> self, void*) {
+            if (g_agentPanicActive || compositorSessionLocked() || !g_backgroundFrameSurface.lock() || Time::steadyNow() >= g_backgroundFrameDeadline) {
+                stopBackgroundFrames(); return;
+            }
+            frame();
+            self->updateTimeout(std::chrono::milliseconds(16));
+        }, nullptr);
+    g_pEventLoopManager->addTimer(g_backgroundFrameTimer);
+}
