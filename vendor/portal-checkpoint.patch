+def atspi_grid_translation(table_node: Any) -> tuple[float, float] | None:
+    """Measure the VCL/GTK coordinate translation from both grid scrollbars.
+
+    Calc may report VCL cell bounds above their native GTK position. Matching
+    scrollbar/wrapper rectangles expose the translation without a pixel guess.
+    Require independent horizontal and vertical agreement; otherwise abstain.
+    """
+    parent = atspi_safe(table_node.get_parent)
+    container = atspi_safe(parent.get_parent) if parent is not None else None
+    offsets: dict[str, list[tuple[float, float]]] = {"horizontal": [], "vertical": []}
+    budget = [200]
+
+    def scan(node: Any, depth: int = 0) -> None:
+        if node is None or depth > 10 or budget[0] <= 0:
+            return
+        budget[0] -= 1
+        role = normalize(atspi_role(node))
+        if role in {"table", "document spreadsheet"}:
+            return
+        if role == "scroll bar":
+            bounds = atspi_extents(node)
+            if bounds is None:
+                return
+            axis = "horizontal" if bounds["width"] > 3 * bounds["height"] else "vertical" if bounds["height"] > 3 * bounds["width"] else None
+            if axis is None:
+                return
+            ancestor = node
+            candidates = set()
+            matching_wrappers = 0
+            for _ in range(8):
+                ancestor = atspi_safe(ancestor.get_parent) if ancestor is not None else None
+                other = atspi_extents(ancestor) if ancestor is not None else None
+                if other and abs(other["width"] - bounds["width"]) <= 1 and abs(other["height"] - bounds["height"]) <= 1:
+                    matching_wrappers += 1
+                    delta = (bounds["x"] - other["x"], bounds["y"] - other["y"])
+                    if delta != (0, 0) and max(abs(v) for v in delta) < 256:
+                        candidates.add(delta)
+            if len(candidates) == 1:
+                offsets[axis].append(candidates.pop())
+            elif not candidates and matching_wrappers >= 4:
+                # Once GTK/VCL have synchronized, their bounds already agree.
+                # Zero is a measured correction, not a missing measurement.
+                offsets[axis].append((0.0, 0.0))
+            return
+        for index in range(min(atspi_child_count(node), 64)):
+            scan(atspi_child_at(node, index), depth + 1)
+
+    scan(container)
+    horizontal, vertical = offsets["horizontal"], offsets["vertical"]
+    if len(horizontal) == len(vertical) == 1 and all(abs(a-b) <= 1 for a, b in zip(horizontal[0], vertical[0])):
+        return horizontal[0]
+    return None
+
