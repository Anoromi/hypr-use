+    assert standard.approval_policy == "external"
+    assert standard.default_authorization == mod.AuthorizationLevel.VIEW
+    default_full_app = make_policy(mod)
+    assert_denied(default_full_app.evaluate(request(mod, destructive=True)), mod.DecisionCode.CONFIRMATION_REQUIRED)
+
+    config = mod.policy_config_from_env({"HYPR_AGENT_PORTAL_PERMISSION_MODE": "full"})
+    assert config.default_authorization == mod.AuthorizationLevel.FULL
+    assert config.clipboard_permissions == frozenset(mod.ClipboardCapability)
+    policy = mod.SecurityPolicy(config)
+    policy.acquire_mutation_lease("test-client")
+    # The token validator must never run when the operator preauthorizes actions.
+    policy._consume_confirmation = lambda _: (_ for _ in ()).throw(AssertionError("unexpected confirmation"))
+    for action in ("click", "launch_app", "press_key", "manage_window"):
+        decision = policy.evaluate(request(mod, action=action, destructive=True))
+        assert decision.allowed and decision.execute
+    preview = policy.evaluate(request(mod, destructive=True), preview_dry_run=True)
+    assert preview.allowed and not preview.execute
+    assert preview.details["wouldRequireConfirmation"] is False
+    assert policy.state()["confirmationMode"] == "never"
+    assert policy.state()["permissionMode"] == "full"
+    assert policy.evaluate(request(mod, destructive=True), mod.GuardInputs(layer_surface_active=True, keyboard_grab_active=True)).execute
+    assert config.human_takeover_enabled is False
+    explicitly_guarded = mod.policy_config_from_env({"HYPR_AGENT_PORTAL_PERMISSION_MODE": "full", "HYPR_AGENT_PORTAL_SECURITY_BLOCK_KEYBOARD_GRAB_MUTATION": "1"})
+    assert_denied(mod.SecurityPolicy(explicitly_guarded).evaluate(request(mod), mod.GuardInputs(keyboard_grab_active=True)), mod.DecisionCode.KEYBOARD_GRAB_ACTIVE)
+    assert_denied(policy.evaluate(request(mod), mod.GuardInputs(panic_active=True)), mod.DecisionCode.PANIC_ACTIVE)
+
+    restricted = mod.policy_config_from_env({
+        "HYPR_AGENT_PORTAL_PERMISSION_MODE": "full",
+        "HYPR_AGENT_PORTAL_CONFINE": "class:org.example.Editor",
+        "HYPR_AGENT_PORTAL_CLIPBOARD": "none",
+        "HYPR_AGENT_PORTAL_SECURITY_MUTATION_LEASE_REQUIRED": "0",
+    })
+    restricted_policy = mod.SecurityPolicy(restricted)
+    assert restricted.clipboard_permissions == frozenset()
+    assert_denied(restricted_policy.evaluate(request(mod, target=window(mod, class_name="other"))), mod.DecisionCode.OUT_OF_SCOPE)
+    assert_denied(restricted_policy.evaluate(request(mod, clipboard_capabilities=frozenset({mod.ClipboardCapability.WRITE}))), mod.DecisionCode.CLIPBOARD_PERMISSION)
+    readonly = mod.policy_config_from_env({"HYPR_AGENT_PORTAL_PERMISSION_MODE": "read-only", "HYPR_AGENT_PORTAL_READONLY": "0"})
+    assert readonly.readonly
+    assert_denied(mod.SecurityPolicy(readonly).evaluate(request(mod)), mod.DecisionCode.READONLY)
+    canonical = mod.policy_config_from_env({"HYPR_AGENT_PORTAL_PERMISSION_MODE": "full", "HYPR_AGENT_PORTAL_SECURITY_PERMISSION_MODE": "standard", "HYPR_AGENT_PORTAL_APPROVAL_POLICY": "never", "HYPR_AGENT_PORTAL_SECURITY_APPROVAL_POLICY": "external"})
+    assert canonical.permission_mode == "standard" and canonical.approval_policy == "external"
