index 0000000..5b8f6cb
--- /dev/null
+++ b/src/plugin/keymap_resolver.hpp
@@ -0,0 +1,35 @@
+#pragma once
+#include <xkbcommon/xkbcommon.h>
+#include <memory>
+#include <optional>
+
+struct ResolvedPortalKey { uint32_t key; xkb_layout_index_t group; };
+
+// Translate the API's US key names to symbols, then resolve those symbols in
+// the client's real keymap. Only the target resource sees the chosen group.
+inline std::optional<ResolvedPortalKey> resolvePortalKey(xkb_keymap* map, uint32_t usKey, uint32_t modifiers, xkb_layout_index_t preferred) {
+    using Context = std::unique_ptr<xkb_context, decltype(&xkb_context_unref)>;
+    using Keymap = std::unique_ptr<xkb_keymap, decltype(&xkb_keymap_unref)>;
+    using State = std::unique_ptr<xkb_state, decltype(&xkb_state_unref)>;
+    Context ctx(xkb_context_new(XKB_CONTEXT_NO_FLAGS), xkb_context_unref);
+    if (!ctx || !map) return std::nullopt;
+    xkb_rule_names names{}; names.layout = "us";
+    Keymap us(xkb_keymap_new_from_names(ctx.get(), &names, XKB_KEYMAP_COMPILE_NO_FLAGS), xkb_keymap_unref);
+    if (!map || !us) return std::nullopt;
+    State reference(xkb_state_new(us.get()), xkb_state_unref);
+    State actual(xkb_state_new(map), xkb_state_unref);
+    if (!reference || !actual) return std::nullopt;
+    xkb_state_update_mask(reference.get(), modifiers, 0, 0, 0, 0, 0);
+    const auto symbol = xkb_state_key_get_one_sym(reference.get(), usKey + 8);
+    if (symbol == XKB_KEY_NoSymbol) return std::nullopt;
+    const auto groups = xkb_keymap_num_layouts(map);
+    for (xkb_layout_index_t offset = 0; offset < groups; ++offset) {
+        const auto group = (preferred + offset) % groups;
+        xkb_state_update_mask(actual.get(), modifiers, 0, 0, 0, 0, group);
+        for (auto code = xkb_keymap_min_keycode(map); code <= xkb_keymap_max_keycode(map); ++code) {
+            if (code >= 8 && xkb_state_key_get_one_sym(actual.get(), code) == symbol)
+                return ResolvedPortalKey{code - 8, group};
+        }
+    }
+    return std::nullopt;
+}
