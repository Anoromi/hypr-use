new file mode 100644
index 0000000..8de818d
--- /dev/null
+++ b/mcp/text_selection.py
@@ -0,0 +1,66 @@
+"""AT-SPI text selection without pointer motion or focus requests."""
+
+import time
+
+
+def wait_readback(read, expected, timeout=0.15):
+    """Allow asynchronous provider updates; never repeat the mutation."""
+    deadline = time.monotonic() + timeout
+    while True:
+        observed = read()
+        if observed == expected:
+            return
+        if time.monotonic() >= deadline:
+            raise ValueError(f'Application did not retain requested state: expected {expected}, observed {observed}')
+        time.sleep(min(0.01, max(0, deadline - time.monotonic())))
+
+
+def selection_range(content, text, prefix='', suffix=''):
+    if not isinstance(text, str) or not text:
+        raise ValueError('select_text requires non-empty text')
+    candidates = []
+    start = 0
+    while True:
+        start = content.find(text, start)
+        if start < 0:
+            break
+        end = start + len(text)
+        if content[:start].endswith(prefix) and content[end:].startswith(suffix):
+            candidates.append((start, end))
+        start += 1
+    if len(candidates) != 1:
+        raise ValueError('Text match is missing or ambiguous; supply prefix/suffix or another element')
+    return candidates[0]
+
+
+def select_node(atspi, node, options):
+    if node is None:
+        raise ValueError('No focused text element; supply element_index')
+    iface = node.get_text_iface()
+    if iface is None:
+        raise ValueError('Element does not expose AT-SPI Text')
+    content = atspi.Text.get_text(iface, 0, -1)
+    start, end = selection_range(content, options['text'], options.get('prefix', ''), options.get('suffix', ''))
+    mode = options.get('selection', 'text')
+    if mode == 'text':
+        if atspi.Text.get_n_selections(iface):
+            accepted = atspi.Text.set_selection(iface, 0, start, end)
+        else:
+            accepted = atspi.Text.add_selection(iface, start, end)
+        if not accepted:
+            raise ValueError('Application refused text selection')
+        def read_selection():
+            observed = atspi.Text.get_selection(iface, 0)
+            return observed.start_offset, observed.end_offset
+        wait_readback(read_selection, (start, end))
+    elif mode in ('cursor_before', 'cursor_after'):
+        for index in reversed(range(atspi.Text.get_n_selections(iface))):
+            if not atspi.Text.remove_selection(iface, index):
+                raise ValueError('Application refused to clear selection')
+        offset = start if mode == 'cursor_before' else end
+        if not atspi.Text.set_caret_offset(iface, offset):
+            raise ValueError('Application refused the requested caret position')
+        wait_readback(lambda: atspi.Text.get_caret_offset(iface), offset)
+    else:
+        raise ValueError('Invalid selection mode')
+    return {'ok': True, 'method': 'atspi', 'selection': mode, 'start': start, 'end': end}
