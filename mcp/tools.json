          "type": "string"
        },
        "element_index": {
          "type": "string"
        },
        "direction": {
          "type": "string",
          "enum": [
            "up",
            "down",
            "left",
            "right"
          ]
        },
        "pages": {
          "type": "number"
        }
      },
