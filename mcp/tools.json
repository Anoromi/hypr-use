  {
    "name": "click",
    "description": "Click an element_index or screenshot pixel x,y in the target app.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "app": {
          "type": "string"
        },
        "element_index": {
          "type": "string"
        },
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        },
        "click_count": {
          "type": "integer",
          "minimum": 1
        },
        "mouse_button": {
          "type": "string",
          "enum": [
            "left",
            "right",
            "middle"
          ]
        }
      },
      "required": [
        "app"
      ],
      "additionalProperties": false
    },
    "annotations": {
      "readOnlyHint": false,
      "openWorldHint": true
    }
  },
  {
