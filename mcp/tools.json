  {
    "name": "select_text",
    "description": "Select matching text, or place the caret before/after it. Optional prefix/suffix disambiguate. Uses the focused text element when element_index is omitted. Requires AT-SPI Text support.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "app": {
          "type": "string"
        },
        "element_index": {
          "type": "string"
        },
        "text": {
          "type": "string"
        },
        "prefix": {
          "type": "string"
        },
        "suffix": {
          "type": "string"
        },
        "selection": {
          "type": "string",
          "enum": [
            "text",
            "cursor_before",
            "cursor_after"
          ]
        }
      },
      "required": [
        "app",
        "text"
      ],
      "additionalProperties": false
    },
    "annotations": {
      "readOnlyHint": false,
      "openWorldHint": true
    }
  },
  {
    "name": "scroll",
    "description": "Scroll an element up/down/left/right by pages; fractional pages are supported.",
    "inputSchema": {
      "type": "object",
      "properties": {
